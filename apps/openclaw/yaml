---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: openclaw
    app.kubernetes.io/name: openclaw
    app.kubernetes.io/part-of: kubesecurebox
  name: openclaw
  namespace: openclaw
spec:
  replicas: 1
  selector:
    matchLabels:
      app: openclaw
      app.kubernetes.io/name: openclaw
      app.kubernetes.io/part-of: kubesecurebox
  template:
    metadata:
      labels:
        app: openclaw
        app.kubernetes.io/name: openclaw
        app.kubernetes.io/part-of: kubesecurebox
    spec:
      containers:
      - env:
        - name: OPENCLAW_PRIMARY_MODEL
          valueFrom:
            configMapKeyRef:
              key: OPENCLAW_PRIMARY_MODEL
              name: openclaw-config
        - name: OPENAI_API_KEY
          valueFrom:
            secretKeyRef:
              key: DEEPSEEK_API_KEY
              name: openclaw-secrets
        - name: OPENCLAW_CUSTOM_CONFIG
          valueFrom:
            configMapKeyRef:
              key: OPENCLAW_CUSTOM_CONFIG
              name: openclaw-config
        - name: DISCORD_ENABLED
          valueFrom:
            configMapKeyRef:
              key: DISCORD_ENABLED
              name: openclaw-config
        - name: LOG_LEVEL
          valueFrom:
            configMapKeyRef:
              key: LOG_LEVEL
              name: openclaw-config
        - name: MEMORY_ENABLED
          valueFrom:
            configMapKeyRef:
              key: MEMORY_ENABLED
              name: openclaw-config
        - name: NODE_OPTIONS
          valueFrom:
            configMapKeyRef:
              key: NODE_OPTIONS
              name: openclaw-config
        - name: OPENCLAW_GATEWAY_TOKEN
          valueFrom:
            configMapKeyRef:
              key: OPENCLAW_GATEWAY_TOKEN
              name: openclaw-config
        - name: DISCORD_TOKEN
          valueFrom:
            secretKeyRef:
              key: DISCORD_TOKEN
              name: openclaw-secrets
        - name: DISCORD_BOT_TOKEN
          valueFrom:
            secretKeyRef:
              key: DISCORD_TOKEN
              name: openclaw-secrets
        - name: OPENAI_AUDIO_API_KEY
          valueFrom:
            secretKeyRef:
              key: OPENAI_AUDIO_API_KEY
              name: openclaw-secrets
        image: coollabsio/openclaw:latest
        livenessProbe:
          exec:
            command:
            - curl
            - -sf
            - http://127.0.0.1:8080/healthz
          failureThreshold: 5
          initialDelaySeconds: 180
          periodSeconds: 30
          timeoutSeconds: 10
        name: openclaw
        ports:
        - containerPort: 8080
          name: http
        - containerPort: 18789
          name: gateway
        - containerPort: 3334
          name: voice-webhook
        readinessProbe:
          exec:
            command:
            - curl
            - -sf
            - http://127.0.0.1:8080/healthz
          failureThreshold: 10
          initialDelaySeconds: 180
          periodSeconds: 15
          timeoutSeconds: 10
        resources:
          limits:
            cpu: 1000m
            memory: 1Gi
          requests:
            cpu: 200m
            memory: 512Mi
        volumeMounts:
        - mountPath: /app/config
          name: custom-config
          readOnly: true
        - mountPath: /data
          name: data
        - mountPath: /data/skills
          name: openclaw-skills
          readOnly: true
      hostAliases:
      - hostnames:
        - browser
        ip: 127.0.0.1
      initContainers:
      - command:
        - openclaw
        - plugins
        - install
        - '@openclaw/voice-call'
        env:
        - name: OPENCLAW_STATE_DIR
          value: /data/.openclaw
        image: coollabsio/openclaw:latest
        name: install-voice-call-plugin
        volumeMounts:
        - mountPath: /data
          name: data
      serviceAccountName: openclaw
      volumes:
      - configMap:
          name: openclaw-custom-config
        name: custom-config
      - configMap:
          name: openclaw-skills
        name: openclaw-skills
      - name: data
        persistentVolumeClaim:
          claimName: openclaw-data
---
